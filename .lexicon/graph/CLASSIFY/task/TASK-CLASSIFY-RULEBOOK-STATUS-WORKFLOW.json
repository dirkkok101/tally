  "recipe_items": [
    {
      "id": "01KYVT29XARB094YJ8V9YQ090R",
      "kind": "acceptance_check",
      "text": [
        "Return bounded durable rule, validation, evaluation, apply, feedback, abandonment, and cleanup state with aggregate counts, identifiers, attribution, fingerprints, lifecycle/staleness, mutation possibility, and one allowed next-operation; never reread corpus or projection payloads."
      ],
      "required": 1,
