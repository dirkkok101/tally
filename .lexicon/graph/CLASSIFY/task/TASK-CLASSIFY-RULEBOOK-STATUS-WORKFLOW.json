    },
    {
      "id": "01KYVT29XB1C4WT2TQ0QGMFEG6",
      "kind": "acceptance_check",
      "text": [
        "Apply status includes terminal totals and unresolved frontier; unknown subjects are stable not-found and failures choose exactly one of retry, resume, re-evaluate, correct, abandon, cleanup, or none."
      ],
      "required": 1,
      "sort_order": 1,
      "created_at": "2026-07-31T10:03:39.8184675+00:00"
    },
    {
      "id": "01KYVT2C15A82G9QKBVS6AA9XM",
      "kind": "constraint",
      "text": [
        "Read-only projection over durable CLASSIFY state and documented public metadata fields."
      ],
      "required": 1,
      "sort_order": 0,
      "created_at": "2026-07-31T10:03:41.9888465+00:00"
    },
    {
      "id": "01KYVT2BA3KX7NYMJVZEZP860J",
      "kind": "expected_output",
      "text": [
